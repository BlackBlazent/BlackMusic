# OS generated files
.DS_Store # macOS folder settings
Thumbs.db # Windows image file cache
Desktop.ini # Windows desktop icon settings

# Editor directories and files
.vscode/   # Visual Studio Code settings
.idea/   # IntelliJ IDEA settings
*.swp   # Vim swap files
*.swo   # Vim swap files
*.swn   # Vim swap files

