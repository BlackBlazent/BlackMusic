# Copy to .env and fill in. Only variables prefixed VITE_ are exposed to the renderer.
#
# IMPORTANT: only put CLIENT IDs here — the public half of an OAuth app registration.
# Never put a client *secret* in a VITE_ variable. Anything prefixed VITE_ gets
# bundled straight into the app's JS and is trivially recoverable by anyone who
# unzips the installer. Secrets belong behind a server you control (a Supabase
# Edge Function is a natural fit here since Supabase Auth is already wired in).

# Supabase (BlackMusic account: email/Google/GitHub/Facebook login)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Spotify — Online service + OAuth (Authorization Code + PKCE, no secret needed).
# Register this exact redirect URI in the Spotify Developer Dashboard:
#   blackmusic://spotify/callback
# (handled by the Tauri deep-link plugin — see src-tauri/tauri.conf.json)
VITE_SPOTIFY_CLIENT_ID=

# GitHub / Google — only used if you wire a Supabase provider instead of these
# directly; kept here for the client-ID-only authorize-URL builders in
# src/lib/services/serviceAuth.ts.
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Audius — public app API key, safe for client-side read access to their catalog
VITE_AUDIUS_API_KEY=

# YouTube Data API — video search for Playground's Video Mode, @youtube: search
VITE_YOUTUBE_API_KEY=

# Genius — lyrics + metadata (access token only; keep the client secret out of here)
VITE_GENIUS_ACCESS_TOKEN=

# Last.fm — album art fallback for tracks with no embedded art. Last.fm's own
# docs use api_key directly in client-side calls for read-only endpoints like
# this one, so this is safe as a VITE_ var (unlike a true OAuth client secret).
VITE_LASTFM_API_KEY=
