{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackMusic",
  "version": "2.0.0",
  "identifier": "com.blackmusic.blackblazent.ravensyntha",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlackMusic 2.0.0",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["blackmusic"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/BlackBlazent/BlackMusic/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NUVFMEZCRDkyQkFEMDgKUldRSXJTdlorK0JlMWx5ZU1OQmlqY1dZTng4eDhWMFhqc1BlQUhIYUMrYmZ5RlZZU1NTaTNsQXQK"
    }
  }
}